# AgentMarket — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your keys below
#   3. .env is in .gitignore — it will NOT be committed to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Required for: Signal Agent, Analysis Agent, Config Optimizer
# Get key:  https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (optional, for sentiment scoring) ────────────────────────────────
# Required for: scores_news/cat_scores/sentiment_score.py (GPT-4 fallback)
# Get key:  https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# ── Twilio (optional, for WhatsApp alerts) ──────────────────────────────────
# Required for: utils/whatsapp_alerts.py
# Get from:  https://console.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=whatsapp:+14155238886
# TWILIO_TO_NUMBER=whatsapp:+972xxxxxxxxx
